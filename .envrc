if ! has nix_direnv_version || ! nix_direnv_version 3.0.4; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.4/direnvrc" "sha256-DzlYZ33mWF/Gs8DDeyjr8mnVmQGx7ASYqA5WlxwvBG4="
fi

# Use the flake's development shell (provides system tools)
use flake

# Activate mise for Python/Node version management
if command -v mise &> /dev/null; then
  eval "$(mise activate bash)"

  # Ensure mise Python is installed
  if ! mise which python &>/dev/null; then
    echo "⚠️  Python not configured in mise. Run: mise install"
  fi

  # Activate Python venv if it exists
  if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
  elif [ -f "venv/bin/activate" ]; then
    source venv/bin/activate
  fi
else
  echo "⚠️  mise not found - install it to manage Python versions"
fi

# Project-specific environment variables
export PYTHONPATH="$PWD:$PYTHONPATH"
export WHISPER_CACHE_DIR="$PWD/.whisper-cache"

# Create cache directories if they don't exist
mkdir -p .whisper-cache

echo "✅ Nix environment loaded (system tools)"
echo "📦 Python: $(which python) $(python --version 2>/dev/null || echo '(not found)')"